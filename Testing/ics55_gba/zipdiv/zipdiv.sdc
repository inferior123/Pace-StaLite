create_clock -name i_clk -period 10 -waveform {0 5} [get_ports {i_clk}]

set_propagated_clock [get_clocks {i_clk}]

set_input_delay  0 -clock i_clk [get_ports {i_reset i_signed i_wr \\i_denominator[0]  \\i_denominator[1]  \\i_denominator[2]  \\i_denominator[3]  \\i_denominator[4]  \\i_denominator[5]  \\i_denominator[6]  \\i_denominator[7]  \\i_denominator[8]  \\i_denominator[9]  \\i_denominator[10]  \\i_denominator[11]  \\i_denominator[12]  \\i_denominator[13]  \\i_denominator[14]  \\i_denominator[15]  \\i_denominator[16]  \\i_denominator[17]  \\i_denominator[18]  \\i_denominator[19]  \\i_denominator[20]  \\i_denominator[21]  \\i_denominator[22]  \\i_denominator[23]  \\i_denominator[24]  \\i_denominator[25]  \\i_denominator[26]  \\i_denominator[27]  \\i_denominator[28]  \\i_denominator[29]  \\i_denominator[30]  \\i_denominator[31]  \\i_numerator[0]  \\i_numerator[1]  \\i_numerator[2]  \\i_numerator[3]  \\i_numerator[4]  \\i_numerator[5]  \\i_numerator[6]  \\i_numerator[7]  \\i_numerator[8]  \\i_numerator[9]  \\i_numerator[10]  \\i_numerator[11]  \\i_numerator[12]  \\i_numerator[13]  \\i_numerator[14]  \\i_numerator[15]  \\i_numerator[16]  \\i_numerator[17]  \\i_numerator[18]  \\i_numerator[19]  \\i_numerator[20]  \\i_numerator[21]  \\i_numerator[22]  \\i_numerator[23]  \\i_numerator[24]  \\i_numerator[25]  \\i_numerator[26]  \\i_numerator[27]  \\i_numerator[28]  \\i_numerator[29]  \\i_numerator[30]  \\i_numerator[31] }]
set_output_delay 0 -clock i_clk [get_ports {o_err o_valid o_busy \\o_quotient[0]  \\o_quotient[1]  \\o_quotient[2]  \\o_quotient[3]  \\o_quotient[4]  \\o_quotient[5]  \\o_quotient[6]  \\o_quotient[7]  \\o_quotient[8]  \\o_quotient[9]  \\o_quotient[10]  \\o_quotient[11]  \\o_quotient[12]  \\o_quotient[13]  \\o_quotient[14]  \\o_quotient[15]  \\o_quotient[16]  \\o_quotient[17]  \\o_quotient[18]  \\o_quotient[19]  \\o_quotient[20]  \\o_quotient[21]  \\o_quotient[22]  \\o_quotient[23]  \\o_quotient[24]  \\o_quotient[25]  \\o_quotient[26]  \\o_quotient[27]  \\o_quotient[28]  \\o_quotient[29]  \\o_quotient[30]  \\o_quotient[31]  \\o_flags[0]  \\o_flags[1]  \\o_flags[2]  \\o_flags[3] }]
